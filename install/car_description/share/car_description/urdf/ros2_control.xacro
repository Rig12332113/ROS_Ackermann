<?xml version="1.0"?>
<robot name="car" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <!-- Rear drive wheels: velocity control -->
        <joint name="base_leftBack_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-20.0</param>
                <param name="max">20.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="base_rightBack_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-20.0</param>
                <param name="max">20.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Front steering joints: position control -->
        <joint name="base_leftFront_steer_joint">
            <command_interface name="position">
                <param name="min">-0.45</param>
                <param name="max">0.45</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="base_rightFront_steer_joint">
            <command_interface name="position">
                <param name="min">-0.45</param>
                <param name="max">0.45</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find car_description)/config/ros2_control.yaml</parameters>
        </plugin>
    </gazebo>
</robot>